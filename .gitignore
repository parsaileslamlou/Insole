# Recorded sensor data — keep raw CSVs out of git unless you deliberately commit one
data/
*.csv

# ...except cal_data/: the calibration dataset is hours of bench captures with
# ~40-min rest intervals between trials, not practically reproducible, and it is
# the tracked input to the committed gain-match derivation. Keep it in git.
!cal_data/*.csv

# Generated gait streams. make_sessions.py writes sim_<label>_<NN>.txt from a
# fixed per-class seed, so they rebuild byte-identical and do not belong in git.
sim_*_[0-9][0-9].txt
# The five unnumbered sim_*.txt from gait_gen.py are deliberately NOT ignored:
# they are committed regression fixtures, and the notebook's Colab bootstrap
# rebuilds every sim_*.csv from them after a fresh clone. Ignoring them would
# leave a clone with no streams to read.

# Jupyter
.ipynb_checkpoints/
*-checkpoint.ipynb
.virtual_documents/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# VS Code
.vscode/

# macOS
.DS_Store
